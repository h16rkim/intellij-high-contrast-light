{
  "name": "High Contrast Islands Light",
  "dark": false,
  "author": "h16rkim",
  "parentTheme": "Islands Light",
  "editorScheme": "/themes/HighContrastLightEditor.xml",
  "colors": {
    "highContrastBlack": "#000000",
    "highContrastBlue": "#183FD5",
    "highContrastWhite": "#FFFFFF",
    "highContrastGray": "#EFEFEF",
    "highContrastYellow": "#FFA511",

    "Borders": "highContrastBlack",
    "Component.borderColor": "highContrastBlack",
    "Panel.borderColor": "highContrastBlack",
    "Table.borderColor": "highContrastBlack",
    "Popup.borderColor": "highContrastBlack",
    "Selection.background": "highContrastBlue",
    "Selection.foreground": "highContrastWhite",

    "Tree.selectionBackground": "highContrastBlue",
    "Tree.selectionForeground": "highContrastWhite",

    "List.selectionBackground": "highContrastBlue",
    "List.selectionInactiveBackground": "highContrastBlue",
    "List.selectionForeground": "highContrastWhite",

    "Table.selectionBackground": "highContrastBlue",
    "Table.selectionForeground": "highContrastWhite",

    "TextField.selectionBackground": "highContrastBlue",
    "TextField.selectionForeground": "highContrastWhite"
  },
  "ui": {
    "Tree": { "selectionBackground": "highContrastBlue", "selectionForeground": "highContrastWhite" },
    "List": { "selectionBackground": "highContrastBlue", "selectionForeground": "highContrastWhite" },
    "Table": { "selectionBackground": "highContrastBlue", "selectionForeground": "highContrastWhite" },
    "Menu": { "selectionBackground": "highContrastBlue", "selectionForeground": "highContrastWhite" },
    "MenuItem": { "selectionBackground": "highContrastBlue", "selectionForeground": "highContrastWhite" },
    "PopupMenu": {
      "selectionBackground": "highContrastBlue",
      "selectionForeground": "highContrastWhite",
      "borderWidth": 1
    },
    "Window": {
      "border": "1,1,1,1,#000000"
    },
    "EditorTabs": {
      "inactiveMaskColor": "#000000FF",
      "underlineColor": "highContrastBlue",
      "inactiveUnderlineColor": "highContrastBlue",
      "underlineHeight": 1
    },
    "DefaultTabs": {
      "underlineColor": "highContrastBlue",
      "inactiveUnderlineColor": "highContrastBlue"
    },
    "ActionButton": {
      "hoverBackground": "highContrastWhite",
      "hoverBorderColor": "highContrastBlack",
      "pressedBackground": "highContrastWhite",
      "pressedBorderColor": "highContrastBlack"
    },
    "Button": {
      "startBackground": "highContrastWhite",
      "endBackground": "highContrastWhite",
      "startBorderColor": "highContrastBlack",
      "endBorderColor": "highContrastBlack",
      "default": {
        "foreground": "highContrastBlack",
        "startBackground": "highContrastWhite",
        "endBackground": "highContrastWhite",
        "startBorderColor": "highContrastBlack",
        "endBorderColor": "highContrastBlack",
        "focusedBorderColor": "highContrastBlack"
      }
    },
    "SegmentedButton": {
      "selectedStartBorderColor": "highContrastBlack",
      "selectedEndBorderColor": "highContrastBlack"
    },
    "Component": {
      "focusWidth": 1
    },
    "Borders": {
      "color": "highContrastBlack",
      "ContrastBorderColor": "highContrastBlack"
    },
    "ToolWindow": {
      "Button": {
        "selectedBackground": "highContrastBlue",
        "selectedForeground": "highContrastWhite"
      },
      "HeaderTab": {
        "underlineColor": "highContrastBlue",
        "inactiveUnderlineColor": "highContrastBlue"
      }
    },
    "Table": {
      "lightSelectionForeground": "highContrastWhite",
      "lightSelectionInactiveForeground": "highContrastWhite",
      "lightSelectionBackground": "highContrastGray",
      "lightSelectionInactiveBackground": "highContrastGray"
    },
    "VersionControl": {
      "Log.Commit.selectionBackground": "highContrastBlue",
      "Log.Commit.selectionInactiveBackground": "highContrastBlue",
      "Log.Commit.selectionForeground": "highContrastWhite",
      "Log.Commit.selectionInactiveForeground": "highContrastWhite",
      "Log.Commit.Reference.foreground": "highContrastYellow"
    },
    "Plugins": {
      "selectionForeground": "highContrastWhite",
      "lightSelectionForeground": "highContrastWhite",
      "hoverBackground": "highContrastBlue",
      "lightSelectionBackground": "highContrastBlue",
      "lightSelectionInactiveBackground": "highContrastBlue"
    },
    "*": {
      "selectionForeground": "highContrastWhite",
      "focusColor": "highContrastBlue",
      "focusedBorderColor": "highContrastBlack",
      "hoverBorderColor": "highContrastBlack",
      "pressedBorderColor": "highContrastBlack",
      "disabledBorderColor": "highContrastBlack"
    }
  },
  "icons": {
    "ColorPalette": {
      "Checkbox.Border.Default": "highContrastBlack",
      "Checkbox.Background.Selected": "highContrastBlue",
      "Checkbox.Border.Selected": "highContrastBlack"
    }
  }
}
