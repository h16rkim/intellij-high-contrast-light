{
  "name": "High Contrast Light",
  "dark": false,
  "author": "h16rkim",
  "editorScheme": "/themes/HighContrastLightEditor.xml",
  "colors": {
    "Borders": "#000000",
    "Component.borderColor": "#000000",
    "Panel.borderColor": "#000000",
    "Table.borderColor": "#000000",
    "Popup.borderColor": "#000000",
    "Selection.background": "#183FD5",
    "Selection.foreground": "#FFFFFF",

    "Tree.selectionBackground": "#183FD5",
    "Tree.selectionForeground": "#FFFFFF",

    "List.selectionBackground": "#183FD5",
    "List.selectionInactiveBackground": "#183FD5",
    "List.selectionForeground": "#FFFFFF",

    "Table.selectionBackground": "#183FD5",
    "Table.selectionForeground": "#FFFFFF",

    "TextField.selectionBackground": "#183FD5",
    "TextField.selectionForeground": "#FFFFFF"
  },
  "ui": {
    "Tree": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "List": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "Table": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "Menu": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "MenuItem": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "PopupMenu": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "Window": {
      "border": "1,1,1,1,#000000"
    },
    "EditorTabs": {
      "inactiveMaskColor": "#000000FF",
      "underlineColor": "#000000",
      "underlineHeight": 1
    },
    "Button": {
      "startBackground": "#FFFFFF",
      "endBackground": "#FFFFFF",
      "startBorderColor": "#000000",
      "endBorderColor": "#000000",
