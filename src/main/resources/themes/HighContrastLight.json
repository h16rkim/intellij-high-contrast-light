{
  "name": "High Contrast Light",
  "dark": false,
  "author": "h16rkim",
  "editorScheme": "/themes/HighContrastLightEditor.xml",
  "colors": {
    "Borders": "#000000",
    "Component.borderColor": "#000000",
    "Panel.borderColor": "#000000",
    "Table.borderColor": "#000000",
    "Popup.borderColor": "#000000",
    "Selection.background": "#183FD5",
    "Selection.foreground": "#FFFFFF",

    "Tree.selectionBackground": "#183FD5",
    "Tree.selectionForeground": "#FFFFFF",

    "List.selectionBackground": "#183FD5",
    "List.selectionInactiveBackground": "#183FD5",
    "List.selectionForeground": "#FFFFFF",

    "Table.selectionBackground": "#183FD5",
    "Table.selectionForeground": "#FFFFFF",

    "TextField.selectionBackground": "#183FD5",
    "TextField.selectionForeground": "#FFFFFF"
  },
  "ui": {
    "Tree": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "List": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "Table": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "Menu": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "MenuItem": { "selectionBackground": "#183FD5", "selectionForeground": "#FFFFFF" },
    "PopupMenu": {
      "selectionBackground": "#183FD5",
      "selectionForeground": "#FFFFFF",
      "borderWidth": 1
    },
    "Window": {
      "border": "1,1,1,1,#000000"
    },
    "EditorTabs": {
      "inactiveMaskColor": "#000000FF",
      "underlineColor": "#183FD5",
      "inactiveUnderlineColor": "#183FD5",
      "underlineHeight": 1
    },
    "DefaultTabs": {
      "underlineColor": "#183FD5",
      "inactiveUnderlineColor": "#183FD5"
    },
    "ActionButton": {
      "hoverBackground": "#FFFFFF",
      "hoverBorderColor": "#000000",
      "pressedBackground": "#FFFFFF",
      "pressedBorderColor": "#000000"
    },
    "Button": {
      "startBackground": "#FFFFFF",
      "endBackground": "#FFFFFF",
      "startBorderColor": "#000000",
      "endBorderColor": "#000000",
      "default": {
        "foreground": "#000000",
        "startBackground": "#FFFFFF",
        "endBackground": "#FFFFFF",
        "startBorderColor": "#000000",
        "endBorderColor": "#000000",
        "focusedBorderColor": "#000000"
      }
    },
    "SegmentedButton": {
      "selectedStartBorderColor": "#000000",
      "selectedEndBorderColor": "#000000"
    },
    "Component": {
      "focusWidth": 1
    },
    "Borders": {
      "color": "#000000",
      "ContrastBorderColor": "#000000"
    },
    "Notification": {
      "iconHoverBackground": "#00000000"
    },
    "ToolWindow": {
      "Button": {
        "selectedBackground": "#183FD5",
        "selectedForeground": "#FFFFFF"
      },
      "HeaderTab": {
        "underlineColor": "#183FD5",
        "inactiveUnderlineColor": "#183FD5"
      }
    },
    "WelcomeScreen": {
      "Projects.selectionForeground": "#FFFFFF"
    },
    "*": {
      "lightSelectionBackground": "#183FD5",
      "lightSelectionForeground": "#FFFFFF",
      "selectionForeground": "#FFFFFF",
      "focusColor": "#183FD5",
      "focusedBorderColor": "#000000",
      "hoverBorderColor": "#000000",
      "pressedBorderColor": "#000000",
      "disabledBorderColor": "#000000",
      "borderColor": "#000000"
    }
  },
  "icons": {
    "ColorPalette": {
      "Checkbox.Border.Default": "#000000",
      "Checkbox.Background.Selected": "#183FD5",
      "Checkbox.Border.Selected": "#000000"
    }
  }
